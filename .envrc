# Activate the Node version pinned in .nvmrc (22) via fnm.
# direnv loads this on entering the dir and reverts on leaving,
# so Node is 22 here and your system default elsewhere.
PATH_add "$HOME/.local/share/fnm"
eval "$(fnm env)"
fnm use --install-if-missing "$(cat .nvmrc)"

# Resolve cross-package imports to TypeScript source (the "webstudio" export
# condition) instead of the unbuilt ./lib. Required so vite/tsx/tests run
# without building every package first. Must be at the Node level, not just
# vite's resolve.conditions (config-file bundling happens before that applies).
export NODE_OPTIONS="--conditions=webstudio${NODE_OPTIONS:+ $NODE_OPTIONS}"
