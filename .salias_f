# Webstudio - project aliases and functions
# Sourced by .salias when the shell enters this directory.
# Run 'help' to see all available commands.
# Node 22 is provided by direnv (.envrc) — automatic on entering this directory.

# ── Setup / run ──
function install --description 'Install deps + build packages vite.config.ts needs (Node 22)'
    pnpm install; and pnpm --filter=@webstudio-is/builder^... build
end

function run --description 'Boot docker (postgres + postgrest), bootstrap DB, start the builder'
    pnpm dev
end

function rmenv --description 'Remove all deps + build/cache dirs (forces a fresh install). Keeps .envrc.'
    bash ./cleanup.sh
end

# ── Fork sync ──
function gitupdate --description "Sync fork from upstream: ff main mirror, rebase mryan work branch"
    set -l current (git branch --show-current)

    # Guard: never run dirty — a checkout could carry stray edits onto the mirror branch.
    if not git diff --quiet; or not git diff --cached --quiet
        echo "Working tree dirty — commit or stash on mryan first."
        return 1
    end

    echo "Fetching upstream..."
    git fetch upstream; or return 1

    echo "Updating main (mirror)..."
    git checkout main; or return 1
    git merge upstream/main --ff-only; or begin
        echo "ff-only failed: main drifted from upstream. Move stray commits to mryan (see gitupdate skill Recovery)."
        return 1
    end
    git push origin main

    echo "Rebasing mryan onto main..."
    git checkout mryan; or return 1
    git rebase main                 # resolve conflicts here if prompted
    git push origin mryan --force-with-lease

    git checkout $current
    echo "Synced: main mirrors upstream, mryan rebased on top."
end

# ── Help ──
function help
    clear
    cat ./.salias_help.txt
end
